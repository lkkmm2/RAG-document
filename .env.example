# ============================================================================
# 复制为 .env 后填写（.env 已在 .gitignore 里，不会被提交）
#
#   cp .env.example .env       # Windows: copy .env.example .env
#
# 只填第一行就能跑真实问答；其余是可选覆盖项。
# ============================================================================

# ---- 必填：大模型 API Key（DeepSeek 或其他 OpenAI 兼容服务）----
DOCQA_LLM__API_KEY=

# ---- 可选：换模型 / 换服务商 ----
# DOCQA_LLM__MODEL=deepseek-chat
# DOCQA_LLM__BASE_URL=https://api.deepseek.com
# DOCQA_LLM__PROVIDER=mock          # 没 Key 时强制用 Mock，跑通链路
# DOCQA_LLM__TEMPERATURE=0.1

# ---- 可选：embedding 与精排 ----
# DOCQA_EMBEDDING__MODEL_NAME=BAAI/bge-small-zh-v1.5
# DOCQA_EMBEDDING__PROVIDER=hashing  # 不下载模型的离线模式，仅用于测试
# DOCQA_RERANK__ENABLED=false

# ---- 可选：服务 ----
# DOCQA_API__PORT=8000
# DOCQA_API__LOG_FORMAT=json
# DOCQA_API__RATE_LIMIT_PER_MIN=120
