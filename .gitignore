# ============================================================
# 密钥与本地配置（绝对不能提交）
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
.venv/
venv/
ENV/
env/
.python-version

# ============================================================
# 测试与工具缓存
# ============================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ============================================================
# 可重建的产物：向量索引、模型权重、报告
# 这些都不该进仓库 —— 索引能重建，模型能重下，报告能重跑
# ============================================================
data/index/
data/models/
# 忽略报告目录里的全部内容，但保留两份可复现的证据（注意：不能直接排除目录本身，
# 否则 git 不会再看目录内的取反规则）
data/eval/reports/*
!data/eval/reports/compare-*.md
!data/eval/reports/demo-*.md
data/tmp/
*.log
install.log

# ============================================================
# 语料文件默认不进仓库（涉及版权与个人隐私）
# 仓库只保留 data/docs/sample.md 这一份可公开的示例。
# 确有需要提交某份文档时：git add -f data/docs/xxx.pdf
# ============================================================
data/docs/*.pdf
data/docs/*.docx
data/docs/*.doc
data/samples/*.pdf

# 运行时上传的临时文件
uploads/
tmp/

# ============================================================
# 编辑器 / 系统
# ============================================================
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================================
# 其它
# ============================================================
*.tmp
*.bak
~$*
